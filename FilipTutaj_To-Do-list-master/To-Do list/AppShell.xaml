<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="To_Do_list.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:To_Do_list"
    Title="To_Do_list">


    <ShellContent
        Title="Menu"
        ContentTemplate="{DataTemplate local:Menu}"
        Route="Menu" />
    <ShellContent
        Title="Archiwum"
        ContentTemplate="{DataTemplate local:Archiwum}"
        Route="Archiwum" />
    <ShellContent
        Title="Dodawanie"
        ContentTemplate="{DataTemplate local:Dodawanie}"
        Route="Dodawanie" />

</Shell>
