<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="To_Do_list.Archiwum"
             Title="Archiwum"
             BackgroundColor="#ABD1B5">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Button
            Clicked="Powrot_Clicked"
            Text="Powrót"
            BackgroundColor="#79B791"
            TextColor="#EDF4ED"
            WidthRequest="80"
            HeightRequest="80"
            />
        </HorizontalStackLayout>
        <Label 
            Text="Archiwum"
            FontSize="70"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            TextColor="#EDF4ED"/>

        <Grid ColumnDefinitions="Auto,*,*,Auto,Auto"
              Padding="10,10,10,0">
            <Label Text="Kod QR"
                   FontAttributes="Bold"
                   TextColor="#EDF4ED"
                   Margin="5"/>
            <Label Grid.Column="1"
                   Text="Numer"
                   FontAttributes="Bold"
                   TextColor="#EDF4ED"
                   Margin="5"/>
            <Label Grid.Column="2"
                   Text="Klasa"
                   FontAttributes="Bold"
                   TextColor="#EDF4ED"
                   Margin="5"/>
            <Label Grid.Column="3"
                   Text="Rozpoczęto"
                   FontAttributes="Bold"
                   TextColor="#EDF4ED"
                   Margin="5"/>
            <Label Grid.Column="4"
                   Text="Zakończono"
                   FontAttributes="Bold"
                   TextColor="#EDF4ED"
                   Margin="5"/>
        </Grid>

        <CollectionView ItemsSource="{Binding Done_Tasks}"
                        BackgroundColor="#79B791">
            <CollectionView.EmptyView>
                <Label Text="Brak ukończonych zadań."
                       HorizontalOptions="Center"
                       TextColor="#EDF4ED"
                       FontSize="20"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,*,Auto,Auto"
                          Padding="10">
                        <Label Text="{Binding D_Name}"
                               TextColor="#EDF4ED"
                               Margin="5"/>
                        <Label Grid.Column="1"
                               Text="{Binding D_Number}"
                               TextColor="#EDF4ED"
                               Margin="5"/>
                        <Label Grid.Column="2"
                               Text="{Binding D_Desc}"
                               TextColor="#EDF4ED"
                               Margin="5"/>
                        <Label Grid.Column="3"
                               Text="{Binding D_StartText}"
                               TextColor="#EDF4ED"
                               Margin="5"/>
                        <Label Grid.Column="4"
                               Text="{Binding D_EndText}"
                               TextColor="#EDF4ED"
                               Margin="5"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>